# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional: configure a provider whose exercise-animation assets have commercial-use rights.
# Use a base URL only after confirming the provider terms. The app appends /{media_id}.mp4
NEXT_PUBLIC_EXERCISE_MEDIA_BASE_URL=
